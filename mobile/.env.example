# Copy this file to .env and fill in the two values from your Supabase project
# (Project settings > API). Only the anon key belongs here.
# Never put the service role key, payment secrets or provider credentials in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Where the web version is hosted, for example https://zedmarket.example
# Shared listing and seller links are built from it. Leave empty and shares are text only.
EXPO_PUBLIC_WEB_URL=
