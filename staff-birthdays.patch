+++ b/mobile/src/domain/birthdays.test.ts
@@ -0,0 +1,73 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import {
+  MAX_WISH,
+  birthdayProblem,
+  boardNote,
+  daysInMonth,
+  daysUntilLabel,
+  formatBirthday,
+  initials,
+  wishProblem,
+  wishesLeft,
+} from './birthdays';
+
+test('month lengths allow 29 February but nothing longer', () => {
+  assert.equal(daysInMonth(2), 29);
+  assert.equal(daysInMonth(4), 30);
+  assert.equal(daysInMonth(12), 31);
+});
+
+test('only real days are accepted', () => {
+  assert.equal(birthdayProblem(3, 5), null);
+  assert.equal(birthdayProblem(2, 29), null);
+  assert.notEqual(birthdayProblem(2, 30), null);
+  assert.notEqual(birthdayProblem(4, 31), null);
+  assert.notEqual(birthdayProblem(13, 1), null);
+  assert.notEqual(birthdayProblem(0, 1), null);
+  assert.notEqual(birthdayProblem(null, 5), null);
+  assert.notEqual(birthdayProblem(5, null), null);
+  assert.notEqual(birthdayProblem(5, 0), null);
+  assert.notEqual(birthdayProblem(5, 1.5), null);
+});
+
+test('a birthday is shown as day and month, never with a year', () => {
+  assert.equal(formatBirthday(3, 5), '5 March');
+  assert.equal(formatBirthday(12, 25), '25 December');
+  assert.equal(formatBirthday(13, 1), '');
+  for (let m = 1; m <= 12; m++) assert.doesNotMatch(formatBirthday(m, 1), /\d{4}/);
+});
+
+test('days until reads naturally', () => {
+  assert.equal(daysUntilLabel(0), 'Today');
+  assert.equal(daysUntilLabel(1), 'Tomorrow');
+  assert.equal(daysUntilLabel(10), 'In 10 days');
+});
+
+test('wishes are checked before sending', () => {
+  assert.notEqual(wishProblem('   '), null);
+  assert.equal(wishProblem('Happy birthday!'), null);
+  assert.notEqual(wishProblem('x'.repeat(MAX_WISH + 1)), null);
+  assert.equal(wishProblem('x'.repeat(MAX_WISH)), null);
+});
+
+test('wishes left never goes below zero', () => {
+  assert.equal(wishesLeft(1, 3), 2);
+  assert.equal(wishesLeft(5, 3), 0);
+});
+
+test('initials for the photo placeholder', () => {
+  assert.equal(initials('Mwila Banda'), 'MB');
+  assert.equal(initials('Thandi'), 'T');
+  assert.equal(initials('  '), '?');
+  assert.equal(initials('Anna Maria Lungu'), 'AL');
+});
+
+test('the board explains why you can or cannot write', () => {
+  assert.match(boardNote({ isMe: true, canWrite: false, written: 0, max: 3 }), /your board/);
+  assert.match(boardNote({ isMe: false, canWrite: true, written: 1, max: 3 }), /2 more wishes/);
+  assert.match(boardNote({ isMe: false, canWrite: true, written: 2, max: 3 }), /1 more wish\./);
+  assert.match(boardNote({ isMe: false, canWrite: false, written: 3, max: 3 }), /most wishes/);
+  assert.match(boardNote({ isMe: false, canWrite: false, written: 0, max: 3 }), /closed/);
+});
diff --git a/mobile/src/domain/birthdays.ts b/mobile/src/domain/birthdays.ts
new file mode 100644
index 00000000..716c9063
--- /dev/null
+++ b/mobile/src/domain/birthdays.ts
@@ -0,0 +1,69 @@
+// Staff birthdays. The database decides who may see what and when notices go out (migration 0017).
+// This file only works out what to show. Only a day and a month are ever stored: there is no year anywhere.
+
+export const MONTHS = [
+  'January', 'February', 'March', 'April', 'May', 'June',
+  'July', 'August', 'September', 'October', 'November', 'December',
+] as const;
+
+export type Visibility = 'staff' | 'hidden';
+
+export const VISIBILITY_LABELS: Record<Visibility, { label: string; hint: string }> = {
+  staff: { label: 'Visible to staff', hint: 'Colleagues see your birthday in the calendar and are told on the day.' },
+  hidden: { label: 'Only me', hint: 'Nobody else sees it or is told. You still get a greeting.' },
+};
+
+// 29 February is allowed. In years that are not leap years it is celebrated on 28 February.
+export function daysInMonth(month: number): number {
+  if (month === 2) return 29;
+  if ([4, 6, 9, 11].includes(month)) return 30;
+  return 31;
+}
+
+export function birthdayProblem(month: number | null, day: number | null): string | null {
+  if (month === null || !Number.isInteger(month) || month < 1 || month > 12) return 'Choose a month.';
+  if (day === null || !Number.isInteger(day) || day < 1) return 'Enter the day of the month.';
+  if (day > daysInMonth(month)) return `${MONTHS[month - 1]} does not have ${day} days.`;
+  return null;
+}
+
+// "5 March". Never a year.
+export function formatBirthday(month: number, day: number): string {
+  if (month < 1 || month > 12) return '';
+  return `${day} ${MONTHS[month - 1]}`;
+}
+
+export function daysUntilLabel(days: number): string {
+  if (days <= 0) return 'Today';
+  if (days === 1) return 'Tomorrow';
+  return `In ${days} days`;
+}
+
+export const MAX_WISH = 500;
+
+export function wishProblem(text: string): string | null {
+  const t = text.trim();
+  if (t.length === 0) return 'Write a wish first.';
+  if (t.length > MAX_WISH) return `Keep it under ${MAX_WISH} characters.`;
+  return null;
+}
+
+export function wishesLeft(written: number, max: number): number {
+  return Math.max(0, max - written);
+}
+
+export function initials(name: string): string {
+  const parts = name.trim().split(/\s+/).filter(Boolean);
+  if (parts.length === 0) return '?';
+  const first = parts[0]?.[0] ?? '';
+  const last = parts.length > 1 ? (parts[parts.length - 1]?.[0] ?? '') : '';
+  return (first + last).toUpperCase();
+}
+
+// The status line on a board, so the person knows why they cannot write.
+export function boardNote(opts: { isMe: boolean; canWrite: boolean; written: number; max: number }): string {
+  if (opts.isMe) return 'This is your board. Colleagues can leave you wishes here.';
+  if (opts.canWrite) return `You can leave ${wishesLeft(opts.written, opts.max)} more wish${wishesLeft(opts.written, opts.max) === 1 ? '' : 'es'}.`;
+  if (opts.written >= opts.max) return 'You have left the most wishes allowed here.';
+  return 'Wishes are closed for this birthday.';
+}
